# Aegis Environment Variables
PROJECT_NAME="Aegis — Quantum-Safe AI Threat Detection System"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="change-this-in-production-super-secret-key"

# Database & Redis (Render PostgreSQL / Redis)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aegis_db"
REDIS_URL="redis://localhost:6379/0"

# Cryptography Settings
PQC_ALGORITHM="ML-KEM-768"
KEY_ROTATION_INTERVAL_HOURS=24

# Model & Storage Paths
MODEL_PATH="models/aegis_ids_xgboost.joblib"
SCALER_PATH="models/aegis_ids_scaler.joblib"
DATA_DIR="data"
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"

# API & Frontend URLs
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL="http://localhost:8000"
